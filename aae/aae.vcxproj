      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ManifestFile>$(ProjectDir)app.manifest</ManifestFile>
      <!--
        aae_core.lib is built entirely of self-registering game drivers (see
        AAE_REGISTER_DRIVER in aae\aae\driver_registry.h): each driver .cpp
        has a file-scope static object whose constructor calls
        aae::RegisterDriver(), and nothing else in the program references
        that object by symbol name. MSVC's linker only pulls a .lib member
        when it resolves an outstanding symbol reference, so with nothing
        outstanding for most driver .obj files, a plain link against
        aae_core.lib silently drops them and aae::AllDrivers() comes back
        with only the handful of drivers whose files happen to be compiled
        directly into THIS project (mhavoc/starwars/tempest/warlord/
        astrocade) - confirmed by rebuilding this exact target and running
        "aae.exe -listallgames": only 49 of the real ~132 games appeared.
        /WHOLEARCHIVE forces every object in aae_core.lib into the link
        regardless of reference, matching the fix applied to the CMake build
        (see CMakeLists.txt's target_link_libraries(aae ...) comment) so both
        build systems produce the same, complete driver registry. Do not
        remove this thinking it is redundant - the games it "adds" are most
        of the emulator's driver roster.
      -->
      <AdditionalOptions>/WHOLEARCHIVE:aae_core.lib %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
