  <!-- ===================================================================
       Vulkan shader home (aae/shaders/vk) - compiled to SPIR-V at build
       time via the vendored tools/glslc.exe (shaderc, committed binary so
       builds need no 3rd-party installs).
       Every future VK shader gets added here as another CustomBuild pair.
       The .spv outputs land in $(OutDir)shaders\vk\ next to the exe and
       are loaded at runtime by the Vulkan chain (Phase 4a Plan 2).
       =================================================================== -->
  <ItemGroup>
    <CustomBuild Include="shaders\vk\fast_poly_vk.vert">
      <Command>if not exist "$(OutDir)shaders\vk" mkdir "$(OutDir)shaders\vk"
"$(ProjectDir)..\tools\glslc.exe" "%(FullPath)" -o "$(OutDir)shaders\vk\%(Filename)%(Extension).spv"</Command>
      <Outputs>$(OutDir)shaders\vk\%(Filename)%(Extension).spv</Outputs>
      <AdditionalInputs>$(ProjectDir)..\tools\glslc.exe</AdditionalInputs>
      <Message>glslc %(Filename)%(Extension)</Message>
    </CustomBuild>
    <CustomBuild Include="shaders\vk\fast_poly_vk.frag">
      <Command>if not exist "$(OutDir)shaders\vk" mkdir "$(OutDir)shaders\vk"
"$(ProjectDir)..\tools\glslc.exe" "%(FullPath)" -o "$(OutDir)shaders\vk\%(Filename)%(Extension).spv"</Command>
      <Outputs>$(OutDir)shaders\vk\%(Filename)%(Extension).spv</Outputs>
      <AdditionalInputs>$(ProjectDir)..\tools\glslc.exe</AdditionalInputs>
      <Message>glslc %(Filename)%(Extension)</Message>
    </CustomBuild>
    <CustomBuild Include="shaders\vk\screen_quad_rect_vk.vert">
      <Command>if not exist "$(OutDir)shaders\vk" mkdir "$(OutDir)shaders\vk"
"$(ProjectDir)..\tools\glslc.exe" "%(FullPath)" -o "$(OutDir)shaders\vk\%(Filename)%(Extension).spv"</Command>
      <Outputs>$(OutDir)shaders\vk\%(Filename)%(Extension).spv</Outputs>
      <AdditionalInputs>$(ProjectDir)..\tools\glslc.exe</AdditionalInputs>
      <Message>glslc %(Filename)%(Extension)</Message>
    </CustomBuild>
    <CustomBuild Include="shaders\vk\screen_quad_rect_vk.frag">
      <Command>if not exist "$(OutDir)shaders\vk" mkdir "$(OutDir)shaders\vk"
"$(ProjectDir)..\tools\glslc.exe" "%(FullPath)" -o "$(OutDir)shaders\vk\%(Filename)%(Extension).spv"</Command>
      <Outputs>$(OutDir)shaders\vk\%(Filename)%(Extension).spv</Outputs>
      <AdditionalInputs>$(ProjectDir)..\tools\glslc.exe</AdditionalInputs>
      <Message>glslc %(Filename)%(Extension)</Message>
    </CustomBuild>
    <CustomBuild Include="shaders\vk\vector_line_vk.vert">
      <Command>if not exist "$(OutDir)shaders\vk" mkdir "$(OutDir)shaders\vk"
"$(ProjectDir)..\tools\glslc.exe" "%(FullPath)" -o "$(OutDir)shaders\vk\%(Filename)%(Extension).spv"</Command>
      <Outputs>$(OutDir)shaders\vk\%(Filename)%(Extension).spv</Outputs>
      <AdditionalInputs>$(ProjectDir)..\tools\glslc.exe</AdditionalInputs>
      <Message>glslc %(Filename)%(Extension)</Message>
